{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "3.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "history"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/Folio-Icon-A-Stylistic.png",
      "24": "icons/Folio-Icon-A-Stylistic.png",
      "32": "icons/Folio-Icon-A-Stylistic.png",
      "48": "icons/Folio-Icon-A-Stylistic.png"
    },
    "theme_icons": [
      {
        "light": "icons/Folio-Icon-Light.png",
        "dark": "icons/Folio-Icon-Dark.png",
        "size": 16
      },
      {
        "light": "icons/Folio-Icon-Light.png",
        "dark": "icons/Folio-Icon-Dark.png",
        "size": 24
      },
      {
        "light": "icons/Folio-Icon-Light.png",
        "dark": "icons/Folio-Icon-Dark.png",
        "size": 32
      },
      {
        "light": "icons/Folio-Icon-Light.png",
        "dark": "icons/Folio-Icon-Dark.png",
        "size": 48
      }
    ],
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/Folio-Icon-Main.png",
    "48": "icons/Folio-Icon-Main.png",
    "128": "icons/Folio-Icon-Main.png"
  },
  "commands": {
    "open-folio-search": {
      "suggested_key": {
        "default": "Ctrl+Space"
      },
      "description": "Open Folio search"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-hook.js"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ]
    }
  ]
}